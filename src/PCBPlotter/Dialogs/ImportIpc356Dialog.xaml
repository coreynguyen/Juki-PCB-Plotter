<Window x:Class="PCBPlotter.Dialogs.ImportIpc356Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import IPC-D-356"
        Width="700" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundMediumBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- File Selection -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="IPC-D-356 File:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="FilePathTextBox" IsReadOnly="True"/>
            <Button Grid.Column="2" Content="Browse..." Click="BrowseButton_Click" Padding="12,4" Margin="8,0,0,0"/>
        </Grid>

        <!-- Import Options -->
        <GroupBox Grid.Row="1" Header="Import Options" Margin="0,0,0,16">
            <StackPanel Margin="8">
                <CheckBox x:Name="CreatePackagesCheckBox" Content="Create packages from pad data" IsChecked="True" Margin="0,0,0,8"/>
                <CheckBox x:Name="CreatePlacementsCheckBox" Content="Create placements from component data" IsChecked="True" Margin="0,0,0,8"/>
                <CheckBox x:Name="ImportNetlistCheckBox" Content="Import netlist connectivity" IsChecked="True"/>
            </StackPanel>
        </GroupBox>

        <!-- Preview -->
        <GroupBox Grid.Row="2" Header="Preview" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Stats -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
                    <TextBlock x:Name="StatsTextBlock" Text="Select a file to preview..."/>
                </StackPanel>

                <!-- Component List -->
                <DataGrid Grid.Row="1" x:Name="ComponentsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ref Des" Binding="{Binding RefDes}" Width="80"/>
                        <DataGridTextColumn Header="Pins" Binding="{Binding PinCount}" Width="50"/>
                        <DataGridTextColumn Header="X" Binding="{Binding CentroidX, StringFormat=F3}" Width="80"/>
                        <DataGridTextColumn Header="Y" Binding="{Binding CentroidY, StringFormat=F3}" Width="80"/>
                        <DataGridTextColumn Header="Width" Binding="{Binding Width, StringFormat=F3}" Width="70"/>
                        <DataGridTextColumn Header="Height" Binding="{Binding Height, StringFormat=F3}" Width="70"/>
                        <DataGridCheckBoxColumn Header="SMT" Binding="{Binding IsSmt}" Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- Import Log -->
        <TextBox Grid.Row="3" x:Name="LogTextBox" Height="60" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"
                 Background="{StaticResource BackgroundDarkBrush}"
                 Foreground="{StaticResource TextSecondaryBrush}"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Import" x:Name="ImportButton" Click="ImportButton_Click"
                    Padding="16,8" Margin="0,0,8,0"
                    Background="{StaticResource AccentPrimaryBrush}"
                    IsEnabled="False"/>
            <Button Content="Cancel" Click="CancelButton_Click" Padding="16,8"/>
        </StackPanel>
    </Grid>
</Window>
