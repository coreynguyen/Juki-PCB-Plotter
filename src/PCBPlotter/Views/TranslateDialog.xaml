<Window x:Class="PCBPlotter.Views.TranslateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Translate Placements" Height="220" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundMediumBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Enter offset to move selected placements:"
                   Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Offset X:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="OffsetXTextBox" Grid.Row="1" Grid.Column="1" Text="0" Padding="4" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="8,0,0,8"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Offset Y:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="OffsetYTextBox" Grid.Row="2" Grid.Column="1" Text="0" Padding="4" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="8,0,0,8"/>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" x:Name="CountLabel" Text="0 placements selected"
                   FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Translate" Width="100" Padding="8,6" IsDefault="True" Click="TranslateButton_Click"/>
            <Button Content="Cancel" Width="80" Padding="8,6" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
