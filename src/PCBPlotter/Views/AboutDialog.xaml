<Window x:Class="PCBPlotter.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PCB Plotter"
        Width="500" Height="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundDarkBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid x:Name="MainGrid">
        <!-- Animated Background Canvas -->
        <Canvas x:Name="BackgroundCanvas" ClipToBounds="True">
            <Canvas.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{DynamicResource BackgroundDark}" Offset="0"/>
                    <GradientStop Color="{DynamicResource BackgroundMedium}" Offset="1"/>
                </LinearGradientBrush>
            </Canvas.Background>
        </Canvas>

        <!-- Content Overlay -->
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo and Title -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <!-- Animated PCB Icon -->
                <Canvas x:Name="LogoCanvas" Width="80" Height="80" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <Ellipse Width="80" Height="80" Fill="{DynamicResource AccentBrush}" Opacity="0.2"/>
                    <Ellipse Width="60" Height="60" Canvas.Left="10" Canvas.Top="10"
                             Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Fill="Transparent"/>
                    <Ellipse Width="20" Height="20" Canvas.Left="30" Canvas.Top="30"
                             Fill="{DynamicResource AccentBrush}"/>
                    <!-- Trace lines -->
                    <Line X1="40" Y1="10" X2="40" Y2="30" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/>
                    <Line X1="70" Y1="40" X2="50" Y2="40" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/>
                    <Line X1="40" Y1="70" X2="40" Y2="50" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/>
                    <Line X1="10" Y1="40" X2="30" Y2="40" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/>
                </Canvas>

                <!-- Title with Glow Effect -->
                <TextBlock x:Name="TitleText" Text="PCB Plotter"
                           FontSize="32" FontWeight="Bold"
                           Foreground="{DynamicResource ForegroundBrush}"
                           HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{DynamicResource Accent}" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock x:Name="VersionText" Text="Version 1.0.0"
                           FontSize="14"
                           Foreground="{DynamicResource ForegroundDimBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Description -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="A modern PCB pick-and-place data preparation tool"
                           FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}"
                           Margin="0,0,0,16"/>

                <TextBlock Text="Features:" FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#x2022; Multiple CAD format import (Altium, Protel, GenCAD, SSA, etc.)"
                               Foreground="{DynamicResource ForegroundDimBrush}" FontSize="12" Margin="0,2"/>
                    <TextBlock Text="&#x2022; Gerber viewer with layer management"
                               Foreground="{DynamicResource ForegroundDimBrush}" FontSize="12" Margin="0,2"/>
                    <TextBlock Text="&#x2022; Juki H8H export format"
                               Foreground="{DynamicResource ForegroundDimBrush}" FontSize="12" Margin="0,2"/>
                    <TextBlock Text="&#x2022; BOM management and component library"
                               Foreground="{DynamicResource ForegroundDimBrush}" FontSize="12" Margin="0,2"/>
                </StackPanel>

                <!-- Easter Egg Button (invisible, triple-click activates 8-bit mode) -->
                <Border x:Name="EasterEggArea" Background="Transparent" Width="100" Height="20" Margin="0,20,0,0"
                        MouseDown="EasterEggArea_MouseDown" Cursor="Hand">
                    <TextBlock x:Name="EasterEggHint" Text=""
                               FontSize="10" Foreground="{DynamicResource ForegroundDimBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="Built with WPF and .NET Framework"
                           FontSize="11"
                           Foreground="{DynamicResource ForegroundDimBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <Button x:Name="CloseButton" Content="Close" Width="100" Padding="12,6"
                        HorizontalAlignment="Center" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
