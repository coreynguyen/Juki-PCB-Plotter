<UserControl x:Class="PCBPlotter.Views.OutputPlotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCBPlotter.Controls"
             Background="{StaticResource BackgroundMediumBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundLightBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1"
                Padding="4">
            <WrapPanel>
                <!-- View Controls -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="View:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ToggleButton Content="Top" Padding="8,4" Margin="0,0,2,0"
                                  IsChecked="{Binding ViewSide, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Top}"/>
                    <ToggleButton Content="Bottom" Padding="8,4"
                                  IsChecked="{Binding ViewSide, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Bottom}"/>
                </StackPanel>

                <!-- Zoom Controls -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Button Content="-" Command="{Binding ZoomOutCommand}" Width="24" Height="24" Padding="0"/>
                    <TextBlock Text="{Binding Zoom, StringFormat={}{0:P0}}"
                               VerticalAlignment="Center" Width="50" TextAlignment="Center"/>
                    <Button Content="+" Command="{Binding ZoomInCommand}" Width="24" Height="24" Padding="0"/>
                    <Button Content="Fit" Command="{Binding ZoomFitCommand}" Margin="4,0,0,0" Padding="8,4"/>
                </StackPanel>

                <!-- Display Options -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <CheckBox Content="Grid" IsChecked="{Binding ShowGrid}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <CheckBox Content="Labels" IsChecked="{Binding ShowLabels}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <CheckBox Content="Polarity" IsChecked="{Binding ShowPolarity}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <CheckBox Content="Instances" IsChecked="{Binding ShowCircuitInstances}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Selection Tools -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Button Content="Select All" Command="{Binding SelectAllCommand}" Padding="8,4" Margin="0,0,2,0"/>
                    <Button Content="Select None" Command="{Binding SelectNoneCommand}" Padding="8,4" Margin="0,0,2,0"/>
                    <Button Content="Same Part" Command="{Binding SelectSamePartCommand}" Padding="8,4" Margin="0,0,2,0"/>
                    <Button Content="Same Package" Command="{Binding SelectSamePackageCommand}" Padding="8,4"/>
                </StackPanel>

                <!-- Selection Sets (3ds Max style) -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Set:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="SelectionSetComboBox" Width="150"
                              ItemsSource="{Binding SelectionSetNames}"
                              Text="{Binding CurrentSelectionSetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              VerticalAlignment="Center"
                              KeyDown="SelectionSetComboBox_KeyDown"
                              SelectionChanged="SelectionSetComboBox_SelectionChanged"
                              ToolTip="Type name and press Enter to save selection, or select existing set"/>
                    <Button Content="X" Width="22" Height="22"
                            Command="{Binding DeleteSelectionSetCommand}"
                            ToolTip="Delete selected set"
                            Margin="2,0,0,0" Padding="0"/>
                    <Button Content="Translate" Command="{Binding TranslateSelectedCommand}"
                            Padding="8,4" Margin="8,0,0,0"
                            ToolTip="Move selected placements by X/Y offset"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Canvas -->
        <controls:DesignCanvas x:Name="DesignCanvas" Grid.Row="1"
                               Zoom="{Binding Zoom, Mode=TwoWay}"
                               PanX="{Binding PanX, Mode=TwoWay}"
                               PanY="{Binding PanY, Mode=TwoWay}"
                               ShowGrid="{Binding ShowGrid}"
                               GridSpacing="{Binding GridSpacing}"
                               ShowLabels="{Binding ShowLabels}"
                               ViewSide="{Binding ViewSide}"
                               Placements="{Binding Project.Placements}"
                               Fiducials="{Binding Project.Fiducials}"
                               Board="{Binding Project.Board}">
            <controls:DesignCanvas.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Show Placement" Command="{Binding ShowPlacementCommand}"
                              ToolTip="Opens Placement tab and scrolls to selected item"/>
                    <Separator/>
                    <MenuItem Header="Add PCB Area..." Command="{Binding AddPcbAreaCommand}"/>
                    <MenuItem Header="Add Placement..." Command="{Binding AddPlacementCommand}"/>
                    <MenuItem Header="Add Fiducial..." Command="{Binding AddFiducialCommand}"/>
                    <Separator/>
                    <MenuItem Header="Set Origin Here" Command="{Binding SetOriginCommand}"/>
                    <Separator/>
                    <MenuItem Header="Select All" Command="{Binding SelectAllCommand}" InputGestureText="Ctrl+A"/>
                    <MenuItem Header="Select None" Command="{Binding SelectNoneCommand}" InputGestureText="Esc"/>
                    <Separator/>
                    <MenuItem Header="Zoom">
                        <MenuItem Header="Zoom In" Command="{Binding ZoomInCommand}"/>
                        <MenuItem Header="Zoom Out" Command="{Binding ZoomOutCommand}"/>
                        <MenuItem Header="Fit to Window" Command="{Binding ZoomFitCommand}"/>
                        <MenuItem Header="100%" Command="{Binding ZoomResetCommand}"/>
                    </MenuItem>
                    <MenuItem Header="View">
                        <MenuItem Header="Top Side" IsCheckable="True"
                                  IsChecked="{Binding ViewSide, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Top}"/>
                        <MenuItem Header="Bottom Side" IsCheckable="True"
                                  IsChecked="{Binding ViewSide, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Bottom}"/>
                    </MenuItem>
                </ContextMenu>
            </controls:DesignCanvas.ContextMenu>
        </controls:DesignCanvas>

        <!-- Bottom Status/Coordinate Bar -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundLightBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0"
                Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Coordinates -->
                <TextBlock Grid.Column="0" Text="{Binding CoordinateDisplay}"
                           FontFamily="Consolas" VerticalAlignment="Center"/>

                <!-- Selection Info -->
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Run Text="Selected: "/>
                    <Run Text="{Binding SelectedPlacements.Count, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>

                <!-- Quick Actions -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="Rotate 90" Command="{Binding RotateSelectionCommand}"
                            CommandParameter="90" Padding="8,2" Margin="0,0,4,0"/>
                    <Button Content="Enable Export" Command="{Binding EnableForExportCommand}"
                            Padding="8,2" Margin="0,0,4,0"/>
                    <Button Content="Focus" Command="{Binding FocusSelectionCommand}" Padding="8,2"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
