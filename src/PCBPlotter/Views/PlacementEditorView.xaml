<UserControl x:Class="PCBPlotter.Views.PlacementEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PCBPlotter.Converters"
             Background="{StaticResource BackgroundMediumBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filter Bar -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundLightBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1"
                Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="Side:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <ComboBox Grid.Column="3" Width="100" VerticalAlignment="Center"
                          SelectedValue="{Binding FilterSide}"
                          SelectedValuePath="Tag">
                    <ComboBoxItem Content="All" Tag="{x:Null}"/>
                    <ComboBoxItem Content="Top" Tag="Top"/>
                    <ComboBoxItem Content="Bottom" Tag="Bottom"/>
                </ComboBox>

                <Button Grid.Column="5" Content="Clear Filter" Command="{Binding ClearFilterCommand}"
                        Padding="8,4"/>
            </Grid>
        </Border>

        <!-- Placement Grid -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding PlacementsView}"
                  SelectedItem="{Binding SelectedPlacements}"
                  SelectionMode="Extended"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  IsReadOnly="False">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="80"/>
                <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat=F3}" Width="80"/>
                <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat=F3}" Width="80"/>
                <DataGridTextColumn Header="Rotation" Binding="{Binding Rotation, StringFormat=F1}" Width="70"/>
                <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="Part Number" Binding="{Binding Component.PartNumber}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Package" Binding="{Binding Package.Name}" Width="100" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="Export Top" Binding="{Binding IsExportEnabledTop}" Width="80"/>
                <DataGridCheckBoxColumn Header="Export Bot" Binding="{Binding IsExportEnabledBottom}" Width="80"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundLightBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0"
                Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Stats -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Total: "/>
                        <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="  |  Filtered: "/>
                        <Run Text="{Binding FilteredCount, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="  |  Selected: "/>
                        <Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Select All Visible" Command="{Binding SelectAllVisibleCommand}"
                            Padding="8,4" Margin="0,0,4,0"/>
                    <Button Content="Focus in Plot" Command="{Binding FocusInPlotCommand}"
                            Padding="8,4" Margin="0,0,4,0"/>
                    <Button Content="Assign Package" Command="{Binding AssignPackageCommand}"
                            Padding="8,4" Margin="0,0,4,0"/>
                    <Button Content="Assign Component" Command="{Binding AssignComponentCommand}"
                            Padding="8,4" Margin="0,0,4,0"/>
                    <Button Content="Enable Export" Command="{Binding EnableExportCommand}"
                            Padding="8,4" Margin="0,0,4,0"/>
                    <Button Content="Delete" Command="{Binding DeleteSelectedCommand}"
                            Padding="8,4" Background="{StaticResource ErrorBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
