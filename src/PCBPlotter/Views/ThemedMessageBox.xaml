<Window x:Class="PCBPlotter.Views.ThemedMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message"
        MinHeight="150" MinWidth="300"
        MaxWidth="500"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundMediumBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Icon -->
        <Border x:Name="IconBorder" Grid.Row="0" Grid.Column="0"
                Width="32" Height="32" Margin="0,0,16,0"
                VerticalAlignment="Top"
                Visibility="Collapsed">
            <Path x:Name="IconPath" Width="24" Height="24" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Message -->
        <TextBlock x:Name="MessageText" Grid.Row="0" Grid.Column="1"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   MaxWidth="400"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" Padding="8,4"
                    Click="OkButton_Click" Visibility="Collapsed"/>
            <Button x:Name="YesButton" Content="Yes" Width="80" Padding="8,4"
                    Click="YesButton_Click" Visibility="Collapsed"/>
            <Button x:Name="NoButton" Content="No" Width="80" Padding="8,4" Margin="8,0,0,0"
                    Click="NoButton_Click" Visibility="Collapsed"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Padding="8,4" Margin="8,0,0,0"
                    Click="CancelButton_Click" Visibility="Collapsed" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
