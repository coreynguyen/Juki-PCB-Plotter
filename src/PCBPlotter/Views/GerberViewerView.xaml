<UserControl x:Class="PCBPlotter.Views.GerberViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCBPlotter.Controls"
             Background="{StaticResource BackgroundMediumBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Layer Panel -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Layers" FontWeight="SemiBold" Margin="8"/>

            <!-- Layer List (ExtendedSelection for multi-select with Ctrl/Shift) -->
            <ListBox x:Name="LayerListBox" Grid.Row="1"
                     ItemsSource="{Binding Layers}"
                     SelectedItem="{Binding SelectedLayer}"
                     SelectionMode="Extended"
                     Margin="8,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}"
                                      VerticalAlignment="Center" Margin="0,0,8,0"
                                      PreviewMouseLeftButtonDown="VisibilityCheckBox_PreviewMouseLeftButtonDown"/>
                            <Border Grid.Column="1" Width="18" Height="18" Margin="0,0,8,0"
                                    BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1"
                                    Cursor="Hand" ToolTip="Click to change color"
                                    MouseLeftButtonDown="ColorBorder_MouseLeftButtonDown">
                                <Rectangle Fill="{Binding Color, Converter={StaticResource ColorToBrushConverter}}"/>
                            </Border>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="* " FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}"
                                           ToolTip="Active layer (selection enabled)"/>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           ToolTip="Double-click to set active / F2 to rename"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Layer Actions -->
            <StackPanel Grid.Row="2" Margin="8">
                <Button Content="Import Gerber" Command="{Binding ImportGerberCommand}" Margin="0,0,0,4"/>
                <Button Content="Remove Layer(s)" Command="{Binding RemoveLayerCommand}" Margin="0,0,0,4"
                        ToolTip="Remove selected layer(s)"/>

                <!-- Rename -->
                <Button Content="Rename (F2)" Command="{Binding RenameLayerCommand}" Margin="0,0,0,8"
                        ToolTip="Rename the selected layer"/>

                <!-- Reorder buttons -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Move Up" Command="{Binding MoveLayerUpCommand}"
                            ToolTip="Move selected layer up in render order" Margin="0,0,2,0"/>
                    <Button Grid.Column="1" Content="Move Down" Command="{Binding MoveLayerDownCommand}"
                            ToolTip="Move selected layer down in render order" Margin="2,0,0,0"/>
                </Grid>

                <!-- Layer stepping -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="[ Prev" Command="{Binding StepLayerUpCommand}"
                            ToolTip="Step to previous layer (PageUp or [)" Margin="0,0,2,0"/>
                    <Button Grid.Column="1" Content="Next ]" Command="{Binding StepLayerDownCommand}"
                            ToolTip="Step to next layer (PageDown or ])" Margin="2,0,0,0"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Show All" Command="{Binding ShowAllLayersCommand}"
                            ToolTip="Show all layers (Shift+A)" Margin="0,0,2,0"/>
                    <Button Grid.Column="1" Content="Hide All" Command="{Binding HideAllLayersCommand}"
                            ToolTip="Hide all layers (H)" Margin="2,0,0,0"/>
                </Grid>
                <Button Content="Invert Visibility" Command="{Binding InvertLayersCommand}"
                        ToolTip="Invert all layer visibility (I)" Margin="0,0,0,4"/>
                <Button Content="Randomize Colors" Command="{Binding RandomizeColorsCommand}"
                        ToolTip="Re-randomize layer colors" Margin="0,0,0,0"/>
            </StackPanel>
        </Grid>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="{StaticResource BorderDarkBrush}"/>

        <!-- Gerber Canvas -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundLightBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1"
                    Padding="8">
                <WrapPanel>
                    <!-- Zoom Controls -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Button Content="-" Command="{Binding ZoomOutCommand}" Width="24" Height="24" Padding="0"/>
                        <TextBlock Text="{Binding Zoom, StringFormat={}{0:P0}}"
                                   VerticalAlignment="Center" Width="50" TextAlignment="Center"/>
                        <Button Content="+" Command="{Binding ZoomInCommand}" Width="24" Height="24" Padding="0"/>
                        <Button Content="Fit" Command="{Binding ZoomFitCommand}" Margin="4,0,0,0" Padding="8,4"/>
                    </StackPanel>

                    <!-- Selection Tools -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Button Content="Select All" Command="{Binding SelectAllCommand}" Padding="8,4" Margin="0,0,4,0"/>
                        <Button Content="Select None" Command="{Binding SelectNoneCommand}" Padding="8,4"/>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Create Package" Command="{Binding CreatePackageFromSelectionCommand}"
                                Padding="8,4" Margin="0,0,4,0"/>
                        <Button Content="Add to Output" Command="{Binding AddSelectionToOutputCommand}"
                                Padding="8,4" Margin="0,0,4,0"/>
                        <Button Content="Set Board Outline" Command="{Binding SetBoardOutlineCommand}"
                                Padding="8,4" Margin="0,0,4,0"/>
                        <Button Content="Set Circuit Outline" Command="{Binding SetCircuitOutlineCommand}"
                                Padding="8,4"/>
                    </StackPanel>

                    <!-- Renderer Selection -->
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                        <TextBlock Text="Renderer:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="RendererComboBox" Width="100"
                                  SelectionChanged="RendererComboBox_SelectionChanged"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="WPF (CPU)"/>
                            <ComboBoxItem Content="OpenGL (GPU)"/>
                        </ComboBox>
                        <CheckBox x:Name="ScreenBlendCheckBox" Content="Screen Blend"
                                  IsChecked="True" VerticalAlignment="Center" Margin="16,0,0,0"
                                  Checked="ScreenBlendCheckBox_Changed" Unchecked="ScreenBlendCheckBox_Changed"/>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- Canvas Container - switches between WPF and OpenGL -->
            <Grid Grid.Row="1">
                <!-- WPF Canvas (CPU) -->
                <controls:DesignCanvas x:Name="GerberCanvas"
                                       Zoom="{Binding Zoom, Mode=TwoWay}"
                                       PanX="{Binding PanX, Mode=TwoWay}"
                                       PanY="{Binding PanY, Mode=TwoWay}"
                                       GerberLayers="{Binding GerberLayersCollection}"
                                       UseScreenBlend="True"
                                       ShowGrid="True">
                    <controls:DesignCanvas.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Add to Output (Enter)" Command="{Binding AddSelectionToOutputCommand}"
                                      ToolTip="Create placement + package from selected pads"/>
                            <MenuItem Header="Create Package Only" Command="{Binding CreatePackageFromSelectionCommand}"
                                      ToolTip="Create a classified package without placement"/>
                            <Separator/>
                            <MenuItem Header="Select All" Command="{Binding SelectAllCommand}"/>
                            <MenuItem Header="Select None" Command="{Binding SelectNoneCommand}"/>
                        </ContextMenu>
                    </controls:DesignCanvas.ContextMenu>
                </controls:DesignCanvas>

                <!-- OpenGL Canvas (GPU) - hidden by default -->
                <controls:OpenGLCanvas x:Name="OpenGLCanvas"
                                       Visibility="Collapsed"
                                       Zoom="{Binding Zoom, Mode=TwoWay}"
                                       PanX="{Binding PanX, Mode=TwoWay}"
                                       PanY="{Binding PanY, Mode=TwoWay}"
                                       GerberLayers="{Binding GerberLayersCollection}"
                                       UseScreenBlend="True"
                                       ShowGrid="True"/>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="{StaticResource BackgroundLightBrush}"
                    BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0"
                    Padding="8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding CoordinateDisplay}"
                               FontFamily="Consolas" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2" VerticalAlignment="Center">
                        <Run Text="Selected: "/>
                        <Run Text="{Binding SelectedPrimitives.Count, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text=" primitives"/>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
