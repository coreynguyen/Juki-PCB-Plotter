<Window x:Class="PCBPlotter.Views.TextImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PCBPlotter.ViewModels"
        xmlns:converters="clr-namespace:PCBPlotter.Converters"
        xmlns:behaviors="clr-namespace:PCBPlotter.Behaviors"
        Title="Import Text Data" Height="650" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundMediumBrush}">

    <Window.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Window.Resources>

    <Window.DataContext>
        <vm:TextImportViewModel/>
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- File Selection -->
        <GroupBox Grid.Row="0" Header="Source File" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseCommand}"
                        Margin="8,0,0,0" Padding="12,4"/>
            </Grid>
        </GroupBox>

        <!-- Parsing Options -->
        <GroupBox Grid.Row="1" Header="Parse Options" Margin="0,0,0,8">
            <WrapPanel Margin="8">
                <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                    <TextBlock Text="Delimiter:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="100" SelectedItem="{Binding SelectedDelimiter}"
                              ItemsSource="{Binding Delimiters}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                    <TextBlock Text="Encoding:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="100" SelectedItem="{Binding SelectedEncoding}"
                              ItemsSource="{Binding Encodings}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                    <TextBlock Text="Skip Rows:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding SkipRows, UpdateSourceTrigger=PropertyChanged}"
                             Width="50"/>
                </StackPanel>

                <CheckBox Content="Treat Consecutive Delimiters as One"
                          IsChecked="{Binding MergeDelimiters}"
                          VerticalAlignment="Center" Margin="0,0,16,4"/>
            </WrapPanel>
        </GroupBox>

        <!-- Data Preview with Column Mapping in Headers -->
        <GroupBox Grid.Row="2" Header="Data Preview and Column Mapping (drag header borders to resize)">
            <DataGrid x:Name="PreviewDataGrid"
                      ItemsSource="{Binding PreviewData}"
                      AutoGenerateColumns="True"
                      AutoGeneratingColumn="PreviewDataGrid_AutoGeneratingColumn"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      HeadersVisibility="Column"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      MinColumnWidth="80"
                      ColumnWidth="120"
                      Validation.ErrorTemplate="{x:Null}"
                      behaviors:DataGridZoomBehavior.EnableZoom="True">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
            </DataGrid>
        </GroupBox>

        <!-- Import Options (only shown for placement imports) -->
        <GroupBox Grid.Row="3" Header="Import Options" Margin="0,8,0,8"
                  Visibility="{Binding ShowPlacementOptions, Converter={StaticResource BoolToVisibilityConverter}}">
            <WrapPanel Margin="8">
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Text="Units:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="100" SelectedItem="{Binding Units}"
                              ItemsSource="{Binding UnitOptions}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Text="Angle Format:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="100" SelectedItem="{Binding AngleFormat}"
                              ItemsSource="{Binding AngleFormats}"/>
                </StackPanel>
            </WrapPanel>
        </GroupBox>

        <!-- BOM Import Options (only shown for BOM imports) -->
        <GroupBox Grid.Row="3" Header="BOM Import Options" Margin="0,8,0,8"
                  Visibility="{Binding ShowPlacementOptions, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <WrapPanel Margin="8">
                <RadioButton Content="Merge with existing BOM"
                             IsChecked="{Binding ClearExistingOnImport, Converter={StaticResource InverseBoolConverter}}"
                             GroupName="BomImportMode" Margin="0,0,24,0"
                             ToolTip="Update existing components and add new ones"/>
                <RadioButton Content="Clear existing BOM and import"
                             IsChecked="{Binding ClearExistingOnImport}"
                             GroupName="BomImportMode"
                             ToolTip="Remove all existing components before importing"/>
            </WrapPanel>
        </GroupBox>

        <!-- Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Mapping:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" Width="180"
                      ItemsSource="{Binding SavedMappingNames}"
                      SelectedItem="{Binding SelectedMappingName, Mode=TwoWay}"
                      IsEditable="False"
                      ToolTip="Select a saved mapping to apply"/>
            <Button Grid.Column="2" Content="Save" Command="{Binding SaveMappingCommand}"
                    Padding="12,6" Margin="8,0,0,0" ToolTip="Save current mappings"/>
            <Button Grid.Column="3" Content="Delete" Command="{Binding DeleteMappingCommand}"
                    Padding="12,6" Margin="4,0,0,0" ToolTip="Delete selected mapping"/>

            <StackPanel Grid.Column="5" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Margin="0,0,16,0">
                    <Run Text="Records: "/>
                    <Run Text="{Binding RecordCount, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="6" Orientation="Horizontal">
                <Button Content="Import" Command="{Binding ImportCommand}"
                        IsDefault="True" Padding="20,6" Margin="0,0,8,0"/>
                <Button Content="Cancel" IsCancel="True" Padding="20,6"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
