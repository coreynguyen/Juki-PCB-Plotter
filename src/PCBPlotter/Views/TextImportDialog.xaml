<Window x:Class="PCBPlotter.Views.TextImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PCBPlotter.ViewModels"
        Title="Import Text Data" Height="650" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundMediumBrush}">

    <Window.DataContext>
        <vm:TextImportViewModel/>
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- File Selection -->
        <GroupBox Grid.Row="0" Header="Source File" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseCommand}"
                        Margin="8,0,0,0" Padding="12,4"/>
            </Grid>
        </GroupBox>

        <!-- Parsing Options -->
        <GroupBox Grid.Row="1" Header="Parse Options" Margin="0,0,0,8">
            <WrapPanel Margin="8">
                <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                    <TextBlock Text="Delimiter:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="100" SelectedItem="{Binding SelectedDelimiter}"
                              ItemsSource="{Binding Delimiters}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                    <TextBlock Text="Encoding:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="100" SelectedItem="{Binding SelectedEncoding}"
                              ItemsSource="{Binding Encodings}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                    <TextBlock Text="Skip Rows:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding SkipRows, UpdateSourceTrigger=PropertyChanged}"
                             Width="50"/>
                </StackPanel>

                <CheckBox Content="Treat Consecutive Delimiters as One"
                          IsChecked="{Binding MergeDelimiters}"
                          VerticalAlignment="Center" Margin="0,0,16,4"/>
            </WrapPanel>
        </GroupBox>

        <!-- Data Preview with Column Mapping -->
        <GroupBox Grid.Row="2" Header="Data Preview and Column Mapping">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column Mapping Header -->
                <Border Grid.Row="0" Background="{StaticResource BackgroundLightBrush}"
                        BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1,1,1,0">
                    <ItemsControl ItemsSource="{Binding ColumnMappings}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="120" BorderBrush="{StaticResource BorderDarkBrush}"
                                        BorderThickness="0,0,1,0">
                                    <ComboBox Margin="2" ItemsSource="{Binding DataContext.AvailableFields,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding SelectedField}"
                                              DisplayMemberPath="DisplayName"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Data Grid (headers hidden - use dropdown mappings above) -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding PreviewData}"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="None"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          ColumnWidth="120"/>
            </Grid>
        </GroupBox>

        <!-- Import Options (only shown for placement imports) -->
        <GroupBox Grid.Row="3" Header="Import Options" Margin="0,8,0,8"
                  Visibility="{Binding ShowPlacementOptions, Converter={StaticResource BoolToVisibilityConverter}}">
            <WrapPanel Margin="8">
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Text="Units:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="100" SelectedItem="{Binding Units}"
                              ItemsSource="{Binding UnitOptions}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Text="Angle Format:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="100" SelectedItem="{Binding AngleFormat}"
                              ItemsSource="{Binding AngleFormats}"/>
                </StackPanel>
            </WrapPanel>
        </GroupBox>

        <!-- Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Save Mapping..." Command="{Binding SaveMappingCommand}"
                    Padding="12,6"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Margin="0,0,16,0">
                    <Run Text="Records: "/>
                    <Run Text="{Binding RecordCount, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Content="Import" Command="{Binding ImportCommand}"
                        IsDefault="True" Padding="20,6" Margin="0,0,8,0"/>
                <Button Content="Cancel" IsCancel="True" Padding="20,6"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
