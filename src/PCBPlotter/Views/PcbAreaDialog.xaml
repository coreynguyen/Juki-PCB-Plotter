<Window x:Class="PCBPlotter.Views.PcbAreaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCB Board Area" Height="320" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundMediumBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Define the PCB board dimensions:"
                   FontWeight="SemiBold" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Board Width:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="WidthTextBox" Grid.Row="1" Grid.Column="1" Text="100" Padding="4" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="8,0,0,8"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Board Height:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="HeightTextBox" Grid.Row="2" Grid.Column="1" Text="100" Padding="4" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="8,0,0,8"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Origin X:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="OriginXTextBox" Grid.Row="3" Grid.Column="1" Text="0" Padding="4" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="3" Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="8,0,0,8"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Origin Y:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="OriginYTextBox" Grid.Row="4" Grid.Column="1" Text="0" Padding="4" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="4" Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="8,0,0,8"/>

        <TextBlock Grid.Row="5" Grid.ColumnSpan="3" Text="Note: Origin defines where (0,0) is located on the board."
                   FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                   Margin="0,8,0,0"/>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Apply" Width="100" Padding="8,6" IsDefault="True" Click="ApplyButton_Click"/>
            <Button Content="Cancel" Width="80" Padding="8,6" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
