<Window x:Class="PCBPlotter.Views.ExportJukiFx3Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Juki FX-3 Program"
        Width="500" Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundMediumBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Export to Juki FX-3 Format (.x01)"
                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <!-- Settings -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- File Settings -->
                <GroupBox Header="File Settings" Margin="0,0,0,12">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Output File:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="OutputFileTextBox" Margin="0,0,8,0"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Click="BrowseButton_Click"
                                Padding="12,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="PWB ID:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="PwbIdTextBox"
                                 Text="PCB-001" Margin="0,8,0,0"/>
                    </Grid>
                </GroupBox>

                <!-- Machine Settings -->
                <GroupBox Header="Machine Settings" Margin="0,0,0,12">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Target Machine:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="TargetMachineCombo" SelectedIndex="0">
                            <ComboBoxItem Content="FX-3"/>
                            <ComboBoxItem Content="FX-2"/>
                            <ComboBoxItem Content="FX-1"/>
                            <ComboBoxItem Content="CX-1"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Reference Side:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="RefSideCombo" SelectedIndex="0" Margin="0,8,0,0">
                            <ComboBoxItem Content="FRONT"/>
                            <ComboBoxItem Content="BACK"/>
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Transfer Dir:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="TransDirCombo" SelectedIndex="0" Margin="0,8,0,0">
                            <ComboBoxItem Content="LTOR" Tag="Left to Right"/>
                            <ComboBoxItem Content="RTOL" Tag="Right to Left"/>
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <!-- Board Settings -->
                <GroupBox Header="Board Settings" Margin="0,0,0,12">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="PWB Thickness:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="PwbThicknessTextBox" Text="1.6"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="8,0,0,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Back Height:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="BackHeightTextBox" Text="12.0" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="8,8,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Layout Offset X:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="LayoutOffsetXTextBox" Text="0.0" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Y:" VerticalAlignment="Center" Margin="8,8,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="3" x:Name="LayoutOffsetYTextBox" Text="0.0" Margin="0,8,0,0"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Export Side:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ExportSideCombo" SelectedIndex="0" Margin="0,8,0,0">
                            <ComboBoxItem Content="Top"/>
                            <ComboBoxItem Content="Bottom"/>
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <!-- Panel/Circuit Settings -->
                <GroupBox Header="Panel Configuration (Optional)" Margin="0,0,0,12">
                    <StackPanel Margin="8">
                        <CheckBox x:Name="UsePanelCheckBox" Content="Enable panel/circuit configuration"
                                  Checked="UsePanelCheckBox_Changed" Unchecked="UsePanelCheckBox_Changed"/>

                        <Grid x:Name="PanelSettingsGrid" IsEnabled="False" Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Circuit Count:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="CircuitCountXTextBox" Text="1"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="x" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="CircuitCountYTextBox" Text="1"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Circuit Pitch:" VerticalAlignment="Center"
                                       Margin="0,8,0,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="CircuitPitchXTextBox" Text="0.0"
                                     Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="x" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBox Grid.Row="1" Grid.Column="3" x:Name="CircuitPitchYTextBox" Text="0.0"
                                     Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="mm" VerticalAlignment="Center"
                                       Margin="8,8,0,0"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Export Options -->
                <GroupBox Header="Export Options">
                    <StackPanel Margin="8">
                        <CheckBox x:Name="IncludeSkippedCheckBox" Content="Include skipped placements"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Preview Info -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundLightBrush}"
                CornerRadius="4" Padding="12" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap"
                               Text="Ready to export..." Foreground="{StaticResource ForegroundSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel" Click="CancelButton_Click" Padding="16,6" Margin="0,0,8,0"/>
                    <Button Content="Export" Click="ExportButton_Click" Padding="16,6"
                            Background="{StaticResource AccentPrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
