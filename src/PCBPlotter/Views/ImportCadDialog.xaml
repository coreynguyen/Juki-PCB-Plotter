<Window x:Class="PCBPlotter.Views.ImportCadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import CAD Data" Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="450" MinWidth="550"
        Background="{DynamicResource BackgroundMediumBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- File Selection -->
        <GroupBox Grid.Row="0" Header="CAD Source File" Margin="0,0,0,12">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SourcePathTextBox" Grid.Row="0" Grid.Column="0"
                         Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                <Button x:Name="BrowseButton" Grid.Row="0" Grid.Column="1"
                        Content="Browse..." Width="80"
                        Click="BrowseButton_Click"/>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Format:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="FormatText" Text="(auto-detected)"
                               VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0"
                           TextWrapping="Wrap" Foreground="{DynamicResource ForegroundDimBrush}">
                    Supported formats: CircuitCAM Express (.cpf, .mdb), Allegro Fabmaster (.val, .fab, .va2)
                </TextBlock>
            </Grid>
        </GroupBox>

        <!-- Parse Status -->
        <GroupBox Grid.Row="1" Header="Parse Status" Margin="0,0,0,12">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                           Text="No file loaded"/>
                <Button x:Name="ParseButton" Grid.Column="1" Content="Parse"
                        Width="80" Click="ParseButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- Preview Data -->
        <GroupBox Grid.Row="2" Header="Preview" Margin="0,0,0,12">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <RadioButton x:Name="ShowPlacementsRadio" Content="Placements" GroupName="Category"
                                 IsChecked="True" Margin="0,0,12,0"
                                 Checked="CategoryRadio_Changed"/>
                    <RadioButton x:Name="ShowFiducialsRadio" Content="Fiducials" GroupName="Category"
                                 Margin="0,0,12,0"
                                 Checked="CategoryRadio_Changed"/>

                    <Separator Margin="12,0,12,0" Style="{x:Null}"/>

                    <TextBlock Text="Side:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <RadioButton x:Name="ShowAllSidesRadio" Content="All" GroupName="Side"
                                 IsChecked="True" Margin="0,0,12,0"
                                 Checked="CategoryRadio_Changed"/>
                    <RadioButton x:Name="ShowTopRadio" Content="Top" GroupName="Side"
                                 Margin="0,0,12,0"
                                 Checked="CategoryRadio_Changed"/>
                    <RadioButton x:Name="ShowBottomRadio" Content="Bottom" GroupName="Side"
                                 Checked="CategoryRadio_Changed"/>
                </StackPanel>

                <DataGrid x:Name="PlacementsGrid" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Extended">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ref" Binding="{Binding RefDes}" Width="70"/>
                        <DataGridTextColumn Header="X (mm)" Binding="{Binding X, StringFormat=F3}" Width="70"/>
                        <DataGridTextColumn Header="Y (mm)" Binding="{Binding Y, StringFormat=F3}" Width="70"/>
                        <DataGridTextColumn Header="Rot" Binding="{Binding Rotation, StringFormat=F1}" Width="50"/>
                        <DataGridTextColumn Header="Side" Binding="{Binding SideText}" Width="55"/>
                        <DataGridTextColumn Header="Package" Binding="{Binding Package}" Width="100"/>
                        <DataGridTextColumn Header="Part Number" Binding="{Binding PartNumber}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- Summary -->
        <GroupBox Grid.Row="3" Header="Summary" Margin="0,0,0,12">
            <TextBlock x:Name="SummaryText" Margin="8" TextWrapping="Wrap"/>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ImportButton" Content="Import" Width="100" Padding="8,4"
                    IsEnabled="False" Click="ImportButton_Click"/>
            <Button Content="Cancel" Width="80" Padding="8,4" Margin="8,0,0,0"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
