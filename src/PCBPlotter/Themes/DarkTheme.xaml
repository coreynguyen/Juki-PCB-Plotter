<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
        <ResourceDictionary Source="Controls.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Window Style -->
    <Style x:Key="DarkWindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- Apply default styles to all controls -->
    <Style TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBoxStyle}"/>
    <Style TargetType="Label" BasedOn="{StaticResource DarkLabelStyle}"/>
    <Style TargetType="CheckBox" BasedOn="{StaticResource DarkCheckBoxStyle}"/>
    <Style TargetType="TabControl" BasedOn="{StaticResource DarkTabControlStyle}"/>
    <Style TargetType="TabItem" BasedOn="{StaticResource DarkTabItemStyle}"/>
    <Style TargetType="ListBox" BasedOn="{StaticResource DarkListBoxStyle}"/>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource DarkListBoxItemStyle}"/>
    <Style TargetType="DataGrid" BasedOn="{StaticResource DarkDataGridStyle}"/>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DarkDataGridColumnHeaderStyle}"/>
    <Style TargetType="DataGridCell" BasedOn="{StaticResource DarkDataGridCellStyle}"/>
    <Style TargetType="Menu" BasedOn="{StaticResource DarkMenuStyle}"/>
    <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItemStyle}"/>
    <Style TargetType="StatusBar" BasedOn="{StaticResource DarkStatusBarStyle}"/>
    <Style TargetType="ToolTip" BasedOn="{StaticResource DarkToolTipStyle}"/>
    <Style TargetType="GroupBox" BasedOn="{StaticResource DarkGroupBoxStyle}"/>

    <!-- Default TextBlock style -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- TreeView Style -->
    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{StaticResource BackgroundDarkBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BackgroundSelectedBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Expander Style -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
    </Style>

    <!-- Slider Style -->
    <Style TargetType="Slider">
        <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
    </Style>

    <!-- ProgressBar Style -->
    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
    </Style>

    <!-- Separator Style -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource BorderDarkBrush}"/>
        <Setter Property="Height" Value="1"/>
    </Style>

    <!-- Context Menu Style -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

</ResourceDictionary>
