<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Background Colors - Light Theme -->
    <Color x:Key="BackgroundDarkColor">#FFF5F5F5</Color>
    <Color x:Key="BackgroundMediumColor">#FFFAFAFA</Color>
    <Color x:Key="BackgroundLightColor">#FFFFFFFF</Color>
    <Color x:Key="BackgroundHoverColor">#FFE8E8E8</Color>
    <Color x:Key="BackgroundSelectedColor">#FFD0E8FF</Color>

    <!-- Border Colors -->
    <Color x:Key="BorderDarkColor">#FFCCCCCC</Color>
    <Color x:Key="BorderLightColor">#FFAAAAAA</Color>
    <Color x:Key="BorderFocusColor">#FF007ACC</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimaryColor">#FF1E1E1E</Color>
    <Color x:Key="TextSecondaryColor">#FF505050</Color>
    <Color x:Key="TextDisabledColor">#FF9A9A9A</Color>
    <Color x:Key="TextHighlightColor">#FF007ACC</Color>

    <!-- Accent Colors -->
    <Color x:Key="AccentPrimaryColor">#FF007ACC</Color>
    <Color x:Key="AccentSecondaryColor">#FF1C97EA</Color>
    <Color x:Key="AccentHoverColor">#FF1C97EA</Color>
    <Color x:Key="AccentPressedColor">#FF005A9E</Color>

    <!-- Status Colors -->
    <Color x:Key="SuccessColor">#FF2D7D46</Color>
    <Color x:Key="WarningColor">#FFB8860B</Color>
    <Color x:Key="ErrorColor">#FFCC0000</Color>
    <Color x:Key="InfoColor">#FF0066CC</Color>

    <!-- Canvas/Editor Colors -->
    <Color x:Key="CanvasBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="CanvasGridColor">#FFE0E0E0</Color>
    <Color x:Key="CanvasGridMajorColor">#FFC0C0C0</Color>
    <Color x:Key="SelectionBoxColor">#400096FF</Color>
    <Color x:Key="SelectionBorderColor">#FF0096FF</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{StaticResource BackgroundDarkColor}"/>
    <SolidColorBrush x:Key="BackgroundMediumBrush" Color="{StaticResource BackgroundMediumColor}"/>
    <SolidColorBrush x:Key="BackgroundLightBrush" Color="{StaticResource BackgroundLightColor}"/>
    <SolidColorBrush x:Key="BackgroundHoverBrush" Color="{StaticResource BackgroundHoverColor}"/>
    <SolidColorBrush x:Key="BackgroundSelectedBrush" Color="{StaticResource BackgroundSelectedColor}"/>

    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDarkColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="TextHighlightBrush" Color="{StaticResource TextHighlightColor}"/>

    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="{StaticResource CanvasBackgroundColor}"/>
    <SolidColorBrush x:Key="CanvasGridBrush" Color="{StaticResource CanvasGridColor}"/>
    <SolidColorBrush x:Key="CanvasGridMajorBrush" Color="{StaticResource CanvasGridMajorColor}"/>
    <SolidColorBrush x:Key="SelectionBoxBrush" Color="{StaticResource SelectionBoxColor}"/>
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="{StaticResource SelectionBorderColor}"/>

</ResourceDictionary>
